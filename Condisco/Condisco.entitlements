<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Personal-team build: Sign in with Apple and iCloud/CloudKit need the
	     paid Apple Developer Program. Re-add com.apple.developer.applesignin,
	     icloud-container-identifiers, icloud-services, and
	     ubiquity-kvstore-identifier when enrolled. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.sleuthysloth.condisco</string>
	</array>
</dict>
</plist>
